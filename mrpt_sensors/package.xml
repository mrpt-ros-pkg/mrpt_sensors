<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mrpt_sensors</name>
  <version>0.3.0</version>
  <description>ROS nodes for various robotics sensors via mrpt-hwdrivers. Metapackage for all mrpt_sensor packages.</description>
  <maintainer email="jlblanco@ual.es">Jose-Luis Blanco-Claraco</maintainer>
  <license>BSD-3-Clause</license>
  <url>https://github.com/mrpt-ros-pkg/mrpt_sensors/</url>

  <author>Jose-Luis Blanco-Claraco</author>
  
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mrpt_sensorlib</depend>
  <depend>mrpt_generic_sensor</depend>

  <!-- Specific sensor packages: -->
  <depend>mrpt_sensor_gnss_nmea</depend>
  <depend>mrpt_sensor_bumblebee_stereo</depend>
  <depend>mrpt_sensor_imu_taobotics</depend>
  <depend>mrpt_sensor_gnss_novatel</depend>



  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
